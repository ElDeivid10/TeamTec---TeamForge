---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/astro/Navigation.astro';
---

<Layout title="Equipo - TeamForge">
  <Navigation />
  
  <main class="min-h-screen pt-20 pb-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <!-- Back Button -->
      <a href="/dashboard" class="inline-flex items-center gap-2 text-slate-400 hover:text-white transition-colors mb-6">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2} d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Volver al dashboard
      </a>

      <!-- Team Content - Will be populated by JavaScript -->
      <div id="team-content" class="animate-fadeIn">
        <!-- Loading State -->
        <div id="loading-state" class="glass-card p-12 text-center">
          <div class="flex justify-center mb-4">
            <svg class="h-12 w-12 animate-spin text-blue-500" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
          </div>
          <p class="text-slate-400">Cargando equipo...</p>
        </div>

        <!-- Error State -->
        <div id="error-state" class="hidden glass-card p-12 text-center">
          <div class="flex justify-center mb-4">
            <div class="w-16 h-16 rounded-2xl bg-red-500/10 border border-red-500/20 flex items-center justify-center">
              <svg class="h-8 w-8 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.34 16.5c-.77.833.192 2.5 1.732 2.5z" />
              </svg>
            </div>
          </div>
          <h3 class="text-xl font-semibold text-white mb-2">Error al cargar el equipo</h3>
          <p id="error-message" class="text-slate-400 mb-6">No se pudo cargar la información del equipo.</p>
          <a href="/dashboard" class="glow-button inline-flex items-center gap-2">
            Volver al dashboard
          </a>
        </div>

        <!-- Team Details -->
        <div id="team-details" class="hidden">
          <!-- Team Header -->
          <div class="glass-card p-8 mb-8">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
              <div class="flex items-center gap-4">
                <div id="team-icon" class="w-16 h-16 rounded-2xl flex items-center justify-center">
                  <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                  </svg>
                </div>
                <div>
                  <h1 id="team-name" class="text-3xl font-bold text-white"></h1>
                  <p id="team-description" class="text-slate-400 mt-1"></p>
                </div>
              </div>
              <div class="flex items-center gap-3">
                <div id="team-stats" class="flex items-center gap-4 px-4 py-2 rounded-xl bg-slate-800/50 border border-slate-700">
                  <div class="text-center">
                    <p id="member-count" class="text-lg font-semibold text-blue-400"></p>
                    <p class="text-xs text-slate-500">Miembros</p>
                  </div>
                  <div class="w-px h-8 bg-slate-700"></div>
                  <div class="text-center">
                    <p id="created-date" class="text-lg font-semibold text-blue-400"></p>
                    <p class="text-xs text-slate-500">Creado</p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Members Section -->
          <div id="members-section">
            <!-- MemberList component will be rendered here -->
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- Invite Member Modal -->
  <div id="invite-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" onclick="closeInviteModal()"></div>
    <div class="relative w-full max-w-md glass-card p-6 animate-fadeIn">
      <div class="flex items-center justify-between mb-6">
        <h3 class="text-xl font-semibold text-white flex items-center gap-2">
          <svg class="h-6 w-6 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
          </svg>
          Invitar miembro
        </h3>
        <button
          onclick="closeInviteModal()"
          class="p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-700/50 transition-colors"
        >
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <div class="relative mb-4">
        <input
          type="text"
          id="invite-search-input"
          placeholder="Buscar usuario por nombre..."
          class="input-field pl-10"
        />
        <svg
          class="absolute left-3 top-1/2 -translate-y-1/2 h-5 w-5 text-slate-500"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>

      <div id="invite-search-results" class="max-h-60 overflow-y-auto mb-4"></div>

      <div id="invite-status" class="hidden"></div>

      <div class="flex justify-end">
        <button
          onclick="closeInviteModal()"
          class="px-4 py-2 rounded-xl text-sm font-medium text-slate-400 hover:text-white hover:bg-slate-700/50 transition-colors"
        >
          Cerrar
        </button>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { supabase } from '../../lib/supabase';

  // Check authentication
  const { data: { session } } = await supabase.auth.getSession();
  if (!session) {
    window.location.href = '/auth/login';
  }

  // Get team ID from URL
  const pathParts = window.location.pathname.split('/');
  const teamId = pathParts[pathParts.length - 1];

  if (!teamId) {
    showError('ID de equipo no válido');
  } else {
    loadTeam(teamId);
  }

  async function loadTeam(teamId: string) {
    try {
      // Fetch team details
      const { data: team, error: teamError } = await supabase
        .from('teams')
        .select('*')
        .eq('id', teamId)
        .single();

      if (teamError || !team) {
        showError('Equipo no encontrado');
        return;
      }

      // Check if user is a member
      const { data: membership, error: memberError } = await supabase
        .from('team_members')
        .select('role')
        .eq('team_id', teamId)
        .eq('user_id', session?.user.id)
        .single();

      if (memberError || !membership) {
        showError('No tienes acceso a este equipo');
        return;
      }

      // Get member count
      const { count } = await supabase
        .from('team_members')
        .select('*', { count: 'exact', head: true })
        .eq('team_id', teamId);

      // Show team details
      showTeam(team, count || 0, membership.role);

    } catch (err) {
      showError('Error inesperado al cargar el equipo');
    }
  }

  function showError(message: string) {
    document.getElementById('loading-state')?.classList.add('hidden');
    document.getElementById('error-state')?.classList.remove('hidden');
    const errorElement = document.getElementById('error-message');
    if (errorElement) {
      errorElement.textContent = message;
    }
  }

  function showTeam(team: any, memberCount: number, userRole: string) {
    document.getElementById('loading-state')?.classList.add('hidden');
    document.getElementById('team-details')?.classList.remove('hidden');

    // Set team info
    const teamName = document.getElementById('team-name');
    const teamDescription = document.getElementById('team-description');
    const teamIcon = document.getElementById('team-icon');
    const memberCountElement = document.getElementById('member-count');
    const createdDate = document.getElementById('created-date');

    if (teamName) teamName.textContent = team.name;
    if (teamDescription) teamDescription.textContent = team.description || 'Sin descripción';
    if (memberCountElement) memberCountElement.textContent = memberCount.toString();
    
    if (createdDate) {
      const date = new Date(team.created_at);
      createdDate.textContent = date.toLocaleDateString('es-ES', {
        day: 'numeric',
        month: 'short',
      });
    }

    // Set team color
    if (teamIcon) {
      teamIcon.style.background = `${team.color || '#3B82F6'}20`;
      teamIcon.style.border = `1px solid ${team.color || '#3B82F6'}40`;
      
      const svgElement = teamIcon.querySelector('svg');
      if (svgElement) {
        svgElement.style.color = team.color || '#3B82F6';
      }
    }

    // Render MemberList React component
    const membersSection = document.getElementById('members-section');
    if (membersSection) {
      // We need to dynamically import and render the React component
      // For now, we'll create a simple member list
      renderMemberList(teamId, userRole);
    }
  }

  async function renderMemberList(teamId: string, userRole: string) {
    const membersSection = document.getElementById('members-section');
    if (!membersSection) return;

    const isOwnerOrAdmin = userRole === 'owner' || userRole === 'admin';

    // Fetch members
    const { data: members, error } = await supabase
      .from('team_members')
      .select('*')
      .eq('team_id', teamId);

    if (error) {
      membersSection.innerHTML = '<p class="text-red-400">Error al cargar miembros</p>';
      return;
    }

    // Fetch profiles for each member
    const membersWithProfiles = await Promise.all(
      (members || []).map(async (member) => {
        const { data: profile } = await supabase
          .from('profiles')
          .select('*')
          .eq('id', member.user_id)
          .single();

        return {
          ...member,
          profile: profile || {
            id: member.user_id,
            full_name: 'Usuario',
            avatar_url: null,
            status: 'offline',
            last_seen: new Date().toISOString(),
            created_at: new Date().toISOString(),
          },
        };
      })
    );

    // Render members
    membersSection.innerHTML = `
      <div class="glass-card p-6">
        <div class="flex items-center justify-between mb-6">
          <h3 class="text-lg font-semibold text-white flex items-center gap-2">
            <svg class="h-5 w-5 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
            Miembros
            <span class="ml-2 text-sm font-normal text-blue-400">${membersWithProfiles.length}</span>
          </h3>
        </div>

        ${isOwnerOrAdmin ? `
          <div class="mb-6">
            <button
              onclick="openInviteModal()"
              class="glow-button inline-flex items-center gap-2"
            >
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
              </svg>
              Invitar miembro
            </button>
          </div>
        ` : ''}

        <div class="space-y-3">
          ${membersWithProfiles.map(member => `
            <div class="flex items-center justify-between p-3 rounded-xl hover:bg-blue-500/5 transition-colors">
              <div class="flex items-center gap-3">
                <div class="relative">
                  <div class="w-10 h-10 rounded-full bg-gradient-to-br from-blue-500 to-blue-700 flex items-center justify-center text-white font-semibold">
                    ${member.profile?.full_name?.charAt(0)?.toUpperCase() || '?'}
                  </div>
                  <div class="absolute -bottom-0.5 -right-0.5 ${getStatusColor(member.profile?.status || 'offline')}"></div>
                </div>
                <div>
                  <p class="text-sm font-medium text-white">${member.profile?.full_name || 'Usuario'}</p>
                  <p class="text-xs text-slate-500">${getStatusText(member.profile?.status || 'offline')}</p>
                </div>
              </div>
              <div class="flex items-center gap-3">
                ${getRoleBadge(member.role)}
                ${isOwnerOrAdmin && member.role !== 'owner' ? `
                  <button
                    onclick="removeMember('${member.user_id}')"
                    class="p-1.5 rounded-lg text-red-400 hover:bg-red-500/10 transition-colors"
                    title="Eliminar miembro"
                  >
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                    </svg>
                  </button>
                ` : ''}
              </div>
            </div>
          `).join('')}
        </div>
      </div>
    `;

    // Setup search functionality if admin/owner
    if (isOwnerOrAdmin) {
      setupSearch(teamId, membersWithProfiles.map(m => m.user_id));
    }
  }

  function getStatusColor(status: string) {
    switch (status) {
      case 'online': return 'status-online';
      case 'away': return 'status-away';
      case 'busy': return 'status-busy';
      default: return 'status-offline';
    }
  }

  function getStatusText(status: string) {
    switch (status) {
      case 'online': return 'En línea';
      case 'away': return 'Ausente';
      case 'busy': return 'Ocupado';
      default: return 'Desconectado';
    }
  }

  function getRoleBadge(role: string) {
    switch (role) {
      case 'owner':
        return '<span class="px-2 py-1 text-xs font-medium rounded-full bg-purple-500/20 text-purple-400 border border-purple-500/30">Owner</span>';
      case 'admin':
        return '<span class="px-2 py-1 text-xs font-medium rounded-full bg-blue-500/20 text-blue-400 border border-blue-500/30">Admin</span>';
      default:
        return '<span class="px-2 py-1 text-xs font-medium rounded-full bg-slate-500/20 text-slate-400 border border-slate-500/30">Miembro</span>';
    }
  }

  function setupSearch(teamId: string, existingMemberIds: string[]) {
    const searchInput = document.getElementById('search-input') as HTMLInputElement;
    const searchResults = document.getElementById('search-results');
    if (!searchInput || !searchResults) return;

    let searchTimeout: NodeJS.Timeout;

    searchInput.addEventListener('input', (e) => {
      const query = (e.target as HTMLInputElement).value;
      clearTimeout(searchTimeout);
      
      if (query.length < 3) {
        searchResults.innerHTML = '';
        return;
      }

      searchTimeout = setTimeout(async () => {
        const { data, error } = await supabase
          .from('profiles')
          .select('*')
          .or(`full_name.ilike.%${query}%,id.ilike.%${query}%`)
          .limit(5);

        if (error || !data) {
          searchResults.innerHTML = '';
          return;
        }

        const filtered = data.filter(profile => !existingMemberIds.includes(profile.id));

        if (filtered.length === 0) {
          searchResults.innerHTML = '<p class="text-sm text-slate-500">No se encontraron usuarios</p>';
          return;
        }

        searchResults.innerHTML = `
          <div class="p-2 rounded-xl bg-slate-800 border border-slate-700">
            ${filtered.map(profile => `
              <div class="flex items-center justify-between p-2 rounded-lg hover:bg-slate-700/50 transition-colors">
                <div class="flex items-center gap-3">
                  <div class="relative">
                    <div class="w-8 h-8 rounded-full bg-gradient-to-br from-blue-500 to-blue-700 flex items-center justify-center text-white text-sm font-semibold">
                      ${profile.full_name?.charAt(0)?.toUpperCase() || '?'}
                    </div>
                    <div class="absolute -bottom-0.5 -right-0.5 w-3 h-3 ${getStatusColor(profile.status || 'offline')}"></div>
                  </div>
                  <div>
                    <p class="text-sm text-white">${profile.full_name || 'Usuario'}</p>
                    <p class="text-xs text-slate-500">${profile.id.substring(0, 8)}...</p>
                  </div>
                </div>
                <button
                  onclick="addMember('${profile.id}', '${teamId}')"
                  class="px-3 py-1.5 rounded-lg text-xs font-medium bg-blue-500/20 text-blue-400 hover:bg-blue-500/30 transition-colors"
                >
                  Agregar
                </button>
              </div>
            `).join('')}
          </div>
        `;
      }, 300);
    });
  }

  // Global functions for member actions
  (window as any).addMember = async (userId: string, teamId: string) => {
    const { error } = await supabase
      .from('team_members')
      .insert({
        team_id: teamId,
        user_id: userId,
        role: 'member',
      });

    if (error) {
      console.error('Error adding member:', error);
      return;
    }

    // Reload team
    loadTeam(teamId);
  };

  (window as any).removeMember = async (userId: string) => {
    if (!confirm('¿Estás seguro de que quieres eliminar a este miembro?')) return;

    const { error } = await supabase
      .from('team_members')
      .delete()
      .eq('team_id', teamId)
      .eq('user_id', userId);

    if (error) {
      console.error('Error removing member:', error);
      return;
    }

    // Reload team
    loadTeam(teamId);
  };

  // Invite modal functions
  (window as any).openInviteModal = () => {
    const modal = document.getElementById('invite-modal');
    const searchInput = document.getElementById('invite-search-input') as HTMLInputElement;
    const searchResults = document.getElementById('invite-search-results');
    
    if (modal) {
      modal.classList.remove('hidden');
      searchInput?.focus();
    }
    if (searchResults) {
      searchResults.innerHTML = '';
    }
  };

  (window as any).closeInviteModal = () => {
    const modal = document.getElementById('invite-modal');
    const searchInput = document.getElementById('invite-search-input') as HTMLInputElement;
    const searchResults = document.getElementById('invite-search-results');
    const status = document.getElementById('invite-status');
    
    if (modal) {
      modal.classList.add('hidden');
    }
    if (searchInput) {
      searchInput.value = '';
    }
    if (searchResults) {
      searchResults.innerHTML = '';
    }
    if (status) {
      status.classList.add('hidden');
      status.innerHTML = '';
    }
  };

  // Setup invite search
  const inviteSearchInput = document.getElementById('invite-search-input') as HTMLInputElement;
  const inviteSearchResults = document.getElementById('invite-search-results');
  
  if (inviteSearchInput && inviteSearchResults) {
    let inviteSearchTimeout: NodeJS.Timeout;

    inviteSearchInput.addEventListener('input', (e) => {
      const query = (e.target as HTMLInputElement).value;
      clearTimeout(inviteSearchTimeout);
      
      if (query.length < 3) {
        inviteSearchResults.innerHTML = '';
        return;
      }

      inviteSearchTimeout = setTimeout(async () => {
        // Get current members to filter them out
        const { data: currentMembers } = await supabase
          .from('team_members')
          .select('user_id')
          .eq('team_id', teamId);
        
        const existingMemberIds = currentMembers?.map(m => m.user_id) || [];

        const { data, error } = await supabase
          .from('profiles')
          .select('*')
          .or(`full_name.ilike.%${query}%,id.ilike.%${query}%`)
          .limit(5);

        if (error || !data) {
          inviteSearchResults.innerHTML = '<p class="text-sm text-slate-500 p-2">Error al buscar usuarios</p>';
          return;
        }

        const filtered = data.filter(profile => !existingMemberIds.includes(profile.id));

        if (filtered.length === 0) {
          inviteSearchResults.innerHTML = '<p class="text-sm text-slate-500 p-2">No se encontraron usuarios disponibles</p>';
          return;
        }

        inviteSearchResults.innerHTML = `
          <div class="p-2 rounded-xl bg-slate-800 border border-slate-700">
            ${filtered.map(profile => `
              <div class="flex items-center justify-between p-2 rounded-lg hover:bg-slate-700/50 transition-colors">
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-full bg-gradient-to-br from-blue-500 to-blue-700 flex items-center justify-center text-white text-sm font-semibold">
                    ${profile.full_name?.charAt(0)?.toUpperCase() || '?'}
                  </div>
                  <div>
                    <p class="text-sm text-white">${profile.full_name || 'Usuario'}</p>
                  </div>
                </div>
                <button
                  onclick="inviteMember('${profile.id}', '${profile.full_name || 'Usuario'}')"
                  class="px-3 py-1.5 rounded-lg text-xs font-medium bg-blue-500/20 text-blue-400 hover:bg-blue-500/30 transition-colors"
                >
                  Invitar
                </button>
              </div>
            `).join('')}
          </div>
        `;
      }, 300);
    });
  }

  (window as any).inviteMember = async (userId: string, userName: string) => {
    const status = document.getElementById('invite-status');
    
    try {
      const { error } = await supabase
        .from('team_members')
        .insert({
          team_id: teamId,
          user_id: userId,
          role: 'member',
        });

      if (error) {
        if (status) {
          status.classList.remove('hidden');
          status.innerHTML = `
            <div class="p-3 rounded-xl bg-red-500/10 border border-red-500/20 text-red-400 text-sm mb-4">
              Error al invitar a ${userName}. Es posible que ya sea miembro.
            </div>
          `;
        }
        return;
      }

      if (status) {
        status.classList.remove('hidden');
        status.innerHTML = `
          <div class="p-3 rounded-xl bg-green-500/10 border border-green-500/20 text-green-400 text-sm mb-4">
            ${userName} ha sido invitado al equipo exitosamente.
          </div>
        `;
      }

      // Clear search
      const searchInput = document.getElementById('invite-search-input') as HTMLInputElement;
      const searchResults = document.getElementById('invite-search-results');
      if (searchInput) searchInput.value = '';
      if (searchResults) searchResults.innerHTML = '';

      // Reload team members
      loadTeam(teamId);

      // Close modal after a delay
      setTimeout(() => {
        (window as any).closeInviteModal();
      }, 2000);

    } catch (err) {
      console.error('Error:', err);
      if (status) {
        status.classList.remove('hidden');
        status.innerHTML = `
          <div class="p-3 rounded-xl bg-red-500/10 border border-red-500/20 text-red-400 text-sm mb-4">
            Error inesperado al invitar a ${userName}.
          </div>
        `;
      }
    }
  };
</script>
