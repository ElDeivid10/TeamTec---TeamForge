---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/astro/Navigation.astro';
---

<Layout title="Registrarse - TeamForge">
  <Navigation />
  
  <main class="min-h-screen pt-16 flex items-center justify-center px-4">
    <div class="w-full max-w-md animate-fadeIn">
      <!-- Background decoration -->
      <div class="absolute inset-0 -z-10">
        <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-blue-500/10 rounded-full blur-3xl"></div>
        <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-blue-700/10 rounded-full blur-3xl"></div>
      </div>

      <!-- Register Card -->
      <div class="glass-card p-8">
        <!-- Header -->
        <div class="text-center mb-8">
          <div class="flex justify-center mb-4">
            <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-gradient-to-br from-blue-500 to-blue-700 shadow-lg shadow-blue-500/25">
              <svg class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
              </svg>
            </div>
          </div>
          <h1 class="text-2xl font-bold text-white mb-2">Crear cuenta</h1>
          <p class="text-slate-400 text-sm">Únete y comienza a crear tus equipos</p>
        </div>

        <!-- Register Form -->
        <form id="register-form" class="space-y-5">
          <!-- Full Name -->
          <div>
            <label for="full_name" class="block text-sm font-medium text-slate-300 mb-2">
              Nombre completo
            </label>
            <input
              type="text"
              id="full_name"
              name="full_name"
              required
              class="input-field"
              placeholder="Juan Pérez"
            />
          </div>

          <!-- Email -->
          <div>
            <label for="email" class="block text-sm font-medium text-slate-300 mb-2">
              Correo electrónico
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="input-field"
              placeholder="tu@email.com"
            />
          </div>

          <!-- Password -->
          <div>
            <label for="password" class="block text-sm font-medium text-slate-300 mb-2">
              Contraseña
            </label>
            <input
              type="password"
              id="password"
              name="password"
              required
              minlength="6"
              class="input-field"
              placeholder="••••••••"
            />
            <p class="mt-1 text-xs text-slate-500">Mínimo 6 caracteres</p>
          </div>

          <!-- Confirm Password -->
          <div>
            <label for="confirm_password" class="block text-sm font-medium text-slate-300 mb-2">
              Confirmar contraseña
            </label>
            <input
              type="password"
              id="confirm_password"
              name="confirm_password"
              required
              class="input-field"
              placeholder="••••••••"
            />
          </div>

          <!-- Error Message -->
          <div id="error-message" class="hidden p-3 rounded-lg bg-red-500/10 border border-red-500/20 text-red-400 text-sm"></div>

          <!-- Success Message -->
          <div id="success-message" class="hidden p-3 rounded-lg bg-green-500/10 border border-green-500/20 text-green-400 text-sm"></div>

          <!-- Submit Button -->
          <button
            type="submit"
            class="glow-button w-full flex items-center justify-center gap-2"
            id="submit-btn"
          >
            <span id="btn-text">Crear cuenta</span>
            <svg id="btn-spinner" class="hidden h-5 w-5 animate-spin" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
          </button>
        </form>

        <!-- Divider -->
        <div class="relative my-6">
          <div class="absolute inset-0 flex items-center">
            <div class="w-full border-t border-slate-700"></div>
          </div>
          <div class="relative flex justify-center text-sm">
            <span class="px-2 bg-slate-900/60 text-slate-500">o</span>
          </div>
        </div>

        <!-- Login Link -->
        <p class="text-center text-sm text-slate-400">
          ¿Ya tienes una cuenta?{' '}
          <a href="/auth/login" class="font-medium text-blue-400 hover:text-blue-300 transition-colors">
            Inicia sesión
          </a>
        </p>
      </div>
    </div>
  </main>
</Layout>

<script>
  import { supabase } from '../../lib/supabase';

  const form = document.getElementById('register-form') as HTMLFormElement;
  const errorMessage = document.getElementById('error-message') as HTMLDivElement;
  const successMessage = document.getElementById('success-message') as HTMLDivElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const btnText = document.getElementById('btn-text') as HTMLSpanElement;
  const btnSpinner = document.getElementById('btn-spinner') as HTMLElement;

  function showError(message: string) {
    errorMessage.textContent = message;
    errorMessage.classList.remove('hidden');
    successMessage.classList.add('hidden');
  }

  function showSuccess(message: string) {
    successMessage.textContent = message;
    successMessage.classList.remove('hidden');
    errorMessage.classList.add('hidden');
  }

  function setLoading(loading: boolean) {
    submitBtn.disabled = loading;
    if (loading) {
      btnText.textContent = 'Creando cuenta...';
      btnSpinner.classList.remove('hidden');
    } else {
      btnText.textContent = 'Crear cuenta';
      btnSpinner.classList.add('hidden');
    }
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    setLoading(true);

    const formData = new FormData(form);
    const fullName = formData.get('full_name') as string;
    const email = formData.get('email') as string;
    const password = formData.get('password') as string;
    const confirmPassword = formData.get('confirm_password') as string;

    // Validate passwords match
    if (password !== confirmPassword) {
      showError('Las contraseñas no coinciden.');
      setLoading(false);
      return;
    }

    try {
      const { data, error } = await supabase.auth.signUp({
        email,
        password,
        options: {
          data: {
            full_name: fullName,
          },
        },
      });

      if (error) {
        let friendlyMessage = error.message;
        
        if (error.message === 'User already registered') {
          friendlyMessage = 'Este correo ya está registrado. Intenta iniciar sesión.';
        } else if (error.message.includes('rate limit') || error.message.includes('over_email_send_rate_limit')) {
          friendlyMessage = 'Se ha superado el límite de emails. Espera unos minutos e intenta de nuevo, o desactiva la confirmación de email en tu panel de Supabase (Authentication > Providers > Email > Confirm email).';
        } else if (error.message.includes('Email logins are disabled')) {
          friendlyMessage = 'El registro con email está deshabilitado.';
        }

        showError(friendlyMessage);
        setLoading(false);
        return;
      }

      if (data.user?.identities?.length === 0) {
        showError('Este correo ya está registrado. Intenta iniciar sesión.');
        setLoading(false);
        return;
      }

      showSuccess('¡Cuenta creada exitosamente! Revisa tu correo para confirmar tu cuenta.');
      form.reset();
      setLoading(false);

    } catch (err) {
      showError('Error inesperado. Inténtalo de nuevo.');
      setLoading(false);
    }
  });
</script>
