---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/astro/Navigation.astro';
import { TeamList } from '../components/react/TeamList';
import { OnlineUsersList } from '../components/react/OnlineUsersList';
---

<Layout title="Dashboard - TeamForge">
  <Navigation />
  
  <main class="min-h-screen pt-20 pb-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <!-- Page Header -->
      <div class="mb-8 animate-fadeIn">
        <h1 class="text-3xl font-bold text-white mb-2">
          Bienvenido a <span class="text-blue-400">TeamForge</span>
        </h1>
        <p class="text-slate-400">
          Gestiona tus equipos y colabora en tiempo real con tu equipo.
        </p>
      </div>

      <!-- Dashboard Layout -->
      <div class="flex flex-col lg:flex-row gap-8">
        <!-- Main Content - Team List -->
        <div class="flex-1 min-w-0">
          <TeamList client:load />
        </div>

        <!-- Sidebar - Online Users -->
        <div class="w-full lg:w-80 flex-shrink-0">
          <div class="sticky top-24 space-y-6">
            <OnlineUsersList client:load />

            <!-- Quick Stats -->
            <div class="glass-card p-6">
              <h3 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
                <svg class="h-5 w-5 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                </svg>
                Actividad reciente
              </h3>
              <div class="space-y-4">
                <div class="flex items-center gap-3 p-3 rounded-lg bg-blue-500/5 border border-blue-500/10">
                  <div class="w-8 h-8 rounded-full bg-blue-500/20 flex items-center justify-center">
                    <svg class="h-4 w-4 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                    </svg>
                  </div>
                  <div>
                    <p class="text-sm text-white">Sesión iniciada</p>
                    <p class="text-xs text-slate-500">Ahora mismo</p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Help Card -->
            <div class="glass-card p-6 bg-gradient-to-br from-blue-500/10 to-blue-700/10">
              <div class="flex items-start gap-3">
                <div class="w-10 h-10 rounded-xl bg-blue-500/20 flex items-center justify-center flex-shrink-0">
                  <svg class="h-5 w-5 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                </div>
                <div>
                  <h4 class="text-sm font-semibold text-white mb-1">¿Necesitas ayuda?</h4>
                  <p class="text-xs text-slate-400 mb-3">
                    Crea un equipo y comienza a colaborar con otros usuarios en tiempo real.
                  </p>
                  <a href="#help" class="text-xs font-medium text-blue-400 hover:text-blue-300 transition-colors">
                    Ver guía →
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  // Check authentication
  const { data: { session } } = await supabase.auth.getSession();
  if (!session) {
    window.location.href = '/auth/login';
  }
</script>
